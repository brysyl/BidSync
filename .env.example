# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VULTR_SERVERLESS_INFERENCE_API_KEY: For Agent 3 strategic bid generation
VULTR_SERVERLESS_INFERENCE_API_KEY="MY_VULTR_API_KEY"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://bidsync_user:securepassword@localhost:5432/bidsync_db"

# REDIS_URL: Redis task queue and state machine cache
REDIS_URL="redis://localhost:6379/0"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

